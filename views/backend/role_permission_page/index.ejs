<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <!-- <h3 class="card-title">Role List</h3> -->
                        <a href="/role-permission/create" class="btn btn-sm btn-info float-right">Add Access Role</a>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="example1" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Nama Role</th>
                                    <th>Permission</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% rolePermission.forEach((data, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td>
                                            <%= data.role.name %>
                                        </td>
                                        <td>
                                            <% data.permission.forEach(ts => { %>
                                                <span class="badge badge-primary"><%= ts.permission.name %></span>
                                            <% }) %>
                                        </td>
                                        <td>
                                            <a href="/role-permission/edit/<%= encrypt(data.role.id.toString()) %>" class="btn btn-sm
                                            btn-warning">Edit</a>
                                            <button id="delete-role-permission" data-role-permission-id="<%= encrypt(data.role.id.toString()) %>" class="btn btn-sm
                                            btn-danger">Delete</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

<script>
    document.querySelectorAll('#delete-role-permission').forEach(button => {
        button.addEventListener('click', function () {
            const roleId = this.getAttribute('data-role-permission-id');
            const confirmDelete = confirm('Apakah anda yakin ingin menghapus role permission?');
            if (confirmDelete) {
                fetch(`/role-permission/delete/${roleId}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            alert('Role Permission berhasil dihapus');
                            window.location.reload();
                        } else {
                            alert('Role Permission gagal dihapus');
                        }
                    })
                    .catch(error => {
                        console.error(error);
                    })
            }
        })
    })
</script>